{% comment %}
  App block. The merchant adds this from the theme editor; we never touch
  theme files, which is what makes the app safe to uninstall.

  No inline script with interpolated data, no jQuery, no global CSS —
  everything renders inside a shadow root in forum.js.

  The colour settings are passed as data attributes rather than baked into the
  stylesheet so one cached forum.js serves every shop.
{% endcomment %}

<div
  class="insider-forum"
  data-forum-root
  data-proxy-url="{{ shop.url }}/apps/forum/posts"
  data-category="{{ block.settings.category | escape }}"
  data-customer-id="{{ customer.id | default: '' }}"
  data-heading="{{ block.settings.heading | escape }}"
  data-scheme="{{ block.settings.color_scheme }}"
  style="
    --ic-accent: {{ block.settings.accent_color }};
    --ic-accent-soft: {{ block.settings.accent_color | color_modify: 'alpha', 0.10 }};
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
  "
>
  <noscript>
    <p>{{ 'forum.javascript_required' | t }}</p>
  </noscript>
</div>

<script src="{{ 'forum.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Community forum",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Community"
    },
    {
      "type": "text",
      "id": "category",
      "label": "Category handle",
      "info": "Leave blank to show every public category."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Pick dark if this section sits on a dark background.",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "light"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "info": "Used for category tags and focus outlines.",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Space above",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Space below",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ]
}
{% endschema %}
