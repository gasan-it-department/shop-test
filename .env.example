# copy to .env
#
# the SHOPIFY_* values below are placeholders that let the app boot with no
# Shopify account: / and /sante and /dev work, /app redirects to oauth and
# stops. `shopify app dev` overwrites all three.
#
# they can't be left blank — shopifyApp() throws at module load on an empty
# appUrl and the whole server 500s, including routes that never touch Shopify.
#
# windows: don't write this file with `Set-Content -Encoding utf8`, it adds a
# BOM and the first var reads back undefined. use an editor or
#   [IO.File]::WriteAllText(".env", $c, (New-Object System.Text.UTF8Encoding $false))

SHOPIFY_API_KEY=00000000000000000000000000000000
SHOPIFY_API_SECRET=00000000000000000000000000000000
SHOPIFY_APP_URL=http://localhost:5182
SCOPES=read_products,read_customers,write_customers

# postgres. locally either:
#   docker compose up -d   ->  the url below
#   or paste the Railway database's PUBLIC url (Variables tab, DATABASE_PUBLIC_URL)
# on Railway itself this is injected from the Postgres service, don't set it there.
DATABASE_URL="postgresql://postgres:dev@localhost:5432/shopify_practice?schema=public"

# 32+ random bytes. rotating this orphans every Member row, so it needs a
# re-hash migration if it ever changes.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SHOPPER_HASH_SECRET=

META_APP_ID=
META_APP_SECRET=
